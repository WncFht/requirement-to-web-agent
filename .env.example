OPENAI_BASE_URL=
OPENAI_API_KEY=
ARC_MODEL=deepseek-flash
ARC_REQUEST_TIMEOUT=600
MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT=100
# passthrough (default) replays reasoning_content byte-exact; strip removes it from requests.
ARC_TRANSPORT_REASONING=passthrough
# Reasoning effort sent to the endpoint (default low). Set empty to omit the parameter.
ARC_REASONING_EFFORT=low
# Audit artifacts elide image base64 by default (verifiable placeholders). Set 1 to keep originals.
ARC_LOG_IMAGES=0
