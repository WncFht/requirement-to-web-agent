* text=auto eol=lf
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.gif -text
*.pdf -text
# Unified diff context lines intentionally contain a single space.
*.patch -whitespace
benchmarks/arc-bench/** -text -whitespace
benchmarks/arc-bench/**/*.zip filter=lfs diff=lfs merge=lfs -text
benchmarks/arc-bench/**/*.gz filter=lfs diff=lfs merge=lfs -text
benchmarks/arc-bench/**/*.png filter=lfs diff=lfs merge=lfs -text
